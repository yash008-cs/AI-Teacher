# ==========================================
# AI Teacher / AI Tutor Environment Variables
# ==========================================

# Active AI Provider ('gemini' for Free Tier or 'openai')
LLM_PROVIDER=gemini

# Google Gemini API Key & Model (Free Tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# OpenAI API Key & Model (Optional provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Zep Cloud API Key (Required for persistent memory)
# Obtain from https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# RAG & Embeddings Configuration
# Provider: 'gemini' (default) or 'openai'
EMBEDDING_PROVIDER=gemini
# Gemini embedding models: 'gemini-embedding-001' or 'gemini-embedding-2'
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OpenAI embedding model (if EMBEDDING_PROVIDER=openai): 'text-embedding-3-small'
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chunking settings
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
# Vector store directory
VECTOR_STORE_PATH=data/vector_store
